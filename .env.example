PORT=3001

DB_HOST=127.0.0.1
# Use 127.0.0.1, not "localhost" -- on Windows + Docker Desktop, "localhost" can resolve to the
# IPv6 ::1 stack, whose port-forwarding to the container can flake (ECONNRESET) after a container
# restart, even though IPv4 works fine.
# Host port. Default changed to 5433 to avoid clashing with a local Postgres install on 5432.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=users_db
# Auto-creates/updates tables from entities. Dev only -- turn off and use migrations in production.
DB_SYNCHRONIZE=true

# Test database (docker-compose.test.yml) -- a separate Postgres container from dev, so
# tests never touch dev data. Reuses DB_USERNAME/DB_PASSWORD above for its credentials.
TEST_DB_PORT=5434
TEST_DB_NAME=users_db_test

POKEMON_API_BASE_URL=https://pokeapi.co/api/v2/pokemon
