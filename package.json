{
  "name": "cursor-backend-challenge",
  "version": "0.0.1",
  "description": "NestJS API scaffold",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "ts-node src/main.ts",
    "start:debug": "ts-node --inspect-brk src/main.ts",
    "start:prod": "node dist/main",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d postgres-test",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "test": "jest",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --testTimeout=600000"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.2.0",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^7.0.0",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/testing": "^10.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.0",
    "dotenv": "^17.4.1",
    "jest": "^29.7.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.3.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
